    "def even_numbers(n):\n",
    "    for number in range(2, n + 1, 2):\n",
    "        yield number\n",
    "\n",
    "\n",
    "numbers = even_numbers(10)\n",
    "\n",
    "print(next(numbers))\n",
    "print(next(numbers))\n",
    "print(next(numbers))"
   ]
